# services/api reads plain environment variables (no .env loader): `set -a; . ./.env; set +a; npm start`.

# Deployments JSON written by the contracts demo scripts, one listing per file, comma-separated, relative to
# services/api. Append "#ticker" to name a file whose ENS section is empty (e.g. a second anvil listing).
DEPLOYMENTS_FILES=../../contracts/deployments/sepolia.json
# Local anvil rehearsal instead (make demo-anvil with KEEP_ANVIL=1):
# DEPLOYMENTS_FILES=../../contracts/deployments/anvil.json
# RPC_URL=http://127.0.0.1:8546

# JSON-RPC endpoint. RPC_URL wins over SEPOLIA_RPC_URL; default: https://ethereum-sepolia-rpc.publicnode.com.
# eth_simulateV1 (prepare with pending approvals, swap priceAfter) and eth_getLogs from the deployment's deployBlock
# must be supported. publicnode keeps only ~1.5 days of logs: for a hosted API use a provider with full log history.
# Server-side only: never expose it to the app as NEXT_PUBLIC_*.
RPC_URL=
SEPOLIA_RPC_URL=
# Expected chain id (default: the first deployments file's chainId, else 11155111). /health is 503 on a mismatch.
CHAIN_ID=

# PORT is honored when a host injects it. The Docker image sets HOST=0.0.0.0.
PORT=8788
HOST=127.0.0.1
# Browser origins allowed by CORS: comma-separated exact origins, *, or one-label wildcards
# (https://*.vercel.app matches https://pr-21.vercel.app, not https://a.b.vercel.app).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# e.g. CORS_ORIGINS=https://listing-day.vercel.app,https://*.vercel.app,http://localhost:3000
# Block explorer for tx / address links in /v1/config (default: Etherscan for Sepolia).
EXPLORER_URL=

# The app reads this API's base URL from NEXT_PUBLIC_API_URL (set it in the app, not here), e.g.
# NEXT_PUBLIC_API_URL=https://listing-day-api.example.com
# ENS parent used when a deployments file has no ens section.
ENS_PARENT_NAME=listingday.eth
# eth_getLogs chunk size in blocks (lower it for RPCs with a smaller range cap).
LOGS_MAX_RANGE=50000

# Address overrides (default: the deployments file, then the Sepolia constants in src/config.ts).
USDC_ADDRESS=
PERMIT2_ADDRESS=
POOL_MANAGER_ADDRESS=
POSITION_MANAGER_ADDRESS=
UNIVERSAL_ROUTER_ADDRESS=
STATE_VIEW_ADDRESS=
QUOTER_ADDRESS=
LBP_STRATEGY_ADDRESS=
MULTICALL3_ADDRESS=
ENS_UNIVERSAL_RESOLVER_ADDRESS=
