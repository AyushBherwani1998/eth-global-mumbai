# services/verify configuration. Copy to .env (git-ignored) and load it with `node --env-file=.env` (npm run start:env).
# Never commit real values. The two private keys below are secrets.

# World Developer Portal (https://developer.world.org): your app, with World ID 4.0 enabled.
WORLD_APP_ID=app_
WORLD_RP_ID=rp_
# The RP signing key the portal shows once when World ID 4.0 is enabled (or rotated). Server-only secret.
WORLD_RP_SIGNING_KEY=
# staging = World ID Simulator (https://simulator.worldcoin.org), the demo. production = real World App users.
# Must match the environment the portal action `listingday-<ticker>` was created in.
WORLD_ENVIRONMENT=staging
# true also accepts World ID 3.0 (legacy Orb) proofs. Off by default: a 3.0 and a 4.0 proof of the same person carry
# different nullifiers, so mixing them lets one person bind two wallets. See README "Legacy proofs".
WORLD_ALLOW_LEGACY_PROOFS=false
# WORLD_VERIFY_BASE_URL=https://developer.world.org
# WORLD_RP_REQUEST_TTL_SECONDS=300

# Pass signer: signs the EligibilityPass the WorldPassModule checks. Its address is the module's immutable `signer`
# (contracts: PASS_SIGNER_ADDRESS, or PASS_SIGNER_KEY for scripted bids). Server-only secret.
PASS_SIGNER_KEY=
# PASS_TTL_SECONDS=600

# Human listings: `make -s verify-listings ELIGIBILITY=human` in ../../contracts prints this after deploy + launch.
# cap is the per-human cap in raw USDC units (20 USDC = 20000000); it must equal what the contracts were deployed with.
LISTINGS=[{"ticker":"acme","chainId":11155111,"auction":"0x0000000000000000000000000000000000000000","module":"0x0000000000000000000000000000000000000000","cap":"20000000"}]
# LISTINGS_FILE=listings.json      # alternative to LISTINGS

# HOST=127.0.0.1
# PORT=8788
# CORS_ORIGIN=*                    # set to the frontend origin in a real deployment
# DB_PATH=data/verify.sqlite
