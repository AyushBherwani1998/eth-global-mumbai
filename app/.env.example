# Thamba — local environment
# Copy to .env.local and fill in. Never commit .env.local or a real key.

# Privy app id. Sign in is handled by Privy (@privy-io/react-auth): email with a
# Privy embedded wallet for people who have never held crypto, plus MetaMask and
# other browser wallets. Create an app at https://dashboard.privy.io and paste
# its App ID here.
#
# Without this the app still boots and signs in: it falls back to a local demo
# sign-in sheet that mirrors the Privy flow (email -> a deterministic demo
# address, or a real browser wallet via window.ethereum). The Privy modal, real
# embedded wallets and session persistence across devices need a real app id.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional. The address that owns the demo listings (Acme, Kesar) and therefore
# sees the issuer console. Defaults to the address in mock/wallet.json.
# For a live demo it is usually easier to sign in normally and then add
# ?issuer=1 to any URL, which allowlists the address you are signed in with.
NEXT_PUBLIC_ISSUER_ADDRESS=
