# Copy to .env (git-ignored); the Makefile loads it. Plain KEY=value lines, no quotes. See DEPLOY.md.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Deployer = issuer = hook and receiver owner; also funder, treasury and CRE broadcaster unless set below.
PRIVATE_KEY=
# At least 6 comma-separated keys: wallets 0-4 bid, wallet 5 trades.
DEMO_WALLET_KEYS=
# Optional: verifies contracts on deploy.
ETHERSCAN_API_KEY=

# Optional overrides
# TREASURY_KEY=
# CRE_BROADCASTER_KEY=      # same key as CRE_ETH_PRIVATE_KEY in ../cre/.env (with 0x here)
# FUNDER_KEY=
# DEMO_LABEL=acme-v1
# BID_WINDOW_BLOCKS=30

# ENSv2 ticker namespace (make ens-sepolia; DEPLOY.md section 5). Both default to PRIVATE_KEY.
# ENS_OWNER_KEY=            # the exchange: owns listingday.eth and the UserRegistry root roles
# ISSUER_KEY=               # owns acme.listingday.eth and its resolver
# ENS_TICKER=acme          # also the World ID action of a human listing: listingday-<ENS_TICKER>
# ENS_ELIGIBILITY=          # leave unset: EnsRecords writes the deployed module's mode (open / human)

# Human listing (ELIGIBILITY=human; DEPLOY.md "Human listing"): WorldPassModule trusts this signer, the same key as
# PASS_SIGNER_KEY in ../services/verify/.env. Deploy needs only the address; `make bids` signs passes with the key.
# ELIGIBILITY=human
# PASS_SIGNER_KEY=
# PASS_SIGNER_ADDRESS=
