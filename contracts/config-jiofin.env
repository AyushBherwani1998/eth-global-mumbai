# JIOFIN (Jio Financial Services) Demo Configuration
# Source: NSE Nov 6 2026 close ₹231.20 (stockanalysis.com)
# Scaled to 100 points baseline for demo

# Price metadata (stored in deployment JSON for UI display)
PRICE_SOURCE="stockanalysis.com"
PRICE_SOURCE_DATE="2026-11-06"
REFERENCE_PRICE_INR="231.20"

# Identity
DEMO_LABEL=jiofin-v1
DEPLOYMENTS_FILE=deployments/sepolia-jiofin.json
STOCK_NAME="Jio Financial Services"
STOCK_SYMBOL=JIOFIN
STOCK_TICKER=jiofin
ENS_TICKER=jiofin

# Price configuration (points: 100 points = 1.00 USDC per 1000 shares demo reference)
# INR ₹231.20 → scaled to 100 points issue
ISSUE_POINTS=100
FLOOR_POINTS=80         # 80% of issue (0.80 USDC per lot)
CAP_PERCENT=190         # Cap at 190% of issue = 190 points

# Supply (shares before 1e18 decimals) - MUST MATCH MockSME FIXED 110k
TOTAL_SUPPLY_SHARES=110000
AUCTION_SUPPLY_SHARES=90000
LP_RESERVE_SHARES=20000

# Auction timing: 5 minutes total ≈ 25 blocks @ 12s
BID_WINDOW_BLOCKS=20    # Zero issuance bidding
CLEAR_BLOCKS=5          # Must divide 1e7

# Minimum raise for graduation (raw USDC 6 decimals)
# At 100 points, 90k shares = 90 USDC target; require 50%
REQUIRED_RAISE_USDC_RAW=45000000

# Per-applicant budget cap
APPLICANT_CAP_USDC_RAW=20000000

# Demo bids: 5 wallets with amounts that clear near issue price
# Total 99 USDC should clear around 110 points with this config
BID_AMOUNTS=20000000,20000000,20000000,20000000,19000000
BID_MAX_POINTS=190
