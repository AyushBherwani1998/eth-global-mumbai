# TCS (Tata Consultancy Services) Demo Configuration  
# Source: NSE Nov 6 2026 close ₹2498.50 (goodreturns.in)
# Scaled proportionally: (2498.50/231.20) * 100 = 1081 points

# Identity
DEMO_LABEL=tcs-v1
DEPLOYMENTS_FILE=deployments/tcs.json
STOCK_NAME="Tata Consultancy Services"
STOCK_SYMBOL=TCS
STOCK_TICKER=tcs
ENS_TICKER=tcs

# Price configuration (INR ₹2498.50 → 1081 points issue)
ISSUE_POINTS=1081
FLOOR_POINTS=865        # 80% of issue
CAP_PERCENT=190         # Cap at 190% = 2054 points

# Supply
TOTAL_SUPPLY_SHARES=110000
AUCTION_SUPPLY_SHARES=90000
LP_RESERVE_SHARES=20000

# Auction timing: 6 hours ≈ 1800 blocks @ 12s
# Leave OPEN for ICO-style bidding - do not run settle immediately
BID_WINDOW_BLOCKS=1750  # Long bid window for open participation
CLEAR_BLOCKS=50         # Must divide 1e7

# Minimum raise: at 1081 points, 90k shares = 973 USDC target; require 50%
# 90000 shares * 1081 points * 0.01 USDC/point / 1000 shares per lot = 973 USDC
REQUIRED_RAISE_USDC_RAW=486000000

# Per-applicant cap
APPLICANT_CAP_USDC_RAW=100000000

# Demo bids: initial seeding only (others can bid during 6-hour window)
# These are placeholder - adjust based on available test USDC
BID_AMOUNTS=100000000,100000000,100000000
BID_MAX_POINTS=2054
