# TCS (Tata Consultancy Services) Demo Configuration  
# Source: NSE Nov 6 2026 close ₹2498.50 (goodreturns.in)
# Scaled proportionally: (2498.50/231.20) * 100 = 1081 points

# Price metadata
PRICE_SOURCE="goodreturns.in"
PRICE_SOURCE_DATE="2026-11-06"
REFERENCE_PRICE_INR="2498.50"

# Identity
DEMO_LABEL=tcs-v1
DEPLOYMENTS_FILE=deployments/sepolia-tcs.json
STOCK_NAME="Tata Consultancy Services"
STOCK_SYMBOL=TCS
STOCK_TICKER=tcs
ENS_TICKER=tcs

# Price configuration (INR ₹2498.50 → 1081 points issue)
ISSUE_POINTS=1081
FLOOR_POINTS=865        # 80% of issue
CAP_PERCENT=190         # Cap at 190% = 2054 points

# Supply: REDUCED to fit deployer USDC budget (449 available)
# At 1081 points, 8k shares ≈ 87 USDC target, require 43 USDC
TOTAL_SUPPLY_SHARES=10000
AUCTION_SUPPLY_SHARES=8000
LP_RESERVE_SHARES=2000

# Auction timing: 6 hours ≈ 1800 blocks @ 12s
# Leave OPEN for ICO-style bidding - do not run settle immediately
BID_WINDOW_BLOCKS=1750  # Long bid window for open participation
CLEAR_BLOCKS=50         # Must divide 1e7

# Minimum raise: REDUCED to fit budget
REQUIRED_RAISE_USDC_RAW=43000000

# Per-applicant cap
APPLICANT_CAP_USDC_RAW=100000000

# Demo bids: initial seeding, stay under budget
# Total 90 USDC for 8k shares at 1081 points  
BID_AMOUNTS=20000000,20000000,20000000,15000000,15000000
BID_MAX_POINTS=2054
