# Reliance Industries Limited Demo Configuration
# Source: NSE Nov 6 2026 close ₹1320.00 (charting.in)
# Scaled proportionally: (1320/231.20) * 100 = 571 points

# Price metadata
PRICE_SOURCE="charting.in"
PRICE_SOURCE_DATE="2026-11-06"
REFERENCE_PRICE_INR="1320.00"

# Identity
DEMO_LABEL=reliance-v1
DEPLOYMENTS_FILE=deployments/sepolia-reliance.json
STOCK_NAME="Reliance Industries Limited"
STOCK_SYMBOL=RELIANCE
STOCK_TICKER=reliance
ENS_TICKER=reliance

# Price configuration (INR ₹1320 → 571 points issue)
ISSUE_POINTS=571
FLOOR_POINTS=457        # 80% of issue
CAP_PERCENT=190         # Cap at 190% = 1085 points

# Supply: REDUCED to fit deployer USDC budget (449 available)
# At 571 points, 15k shares ≈ 86 USDC target, require 43 USDC
TOTAL_SUPPLY_SHARES=18000
AUCTION_SUPPLY_SHARES=15000
LP_RESERVE_SHARES=3000

# Auction timing: 5 minutes total
BID_WINDOW_BLOCKS=20
CLEAR_BLOCKS=5

# Minimum raise: REDUCED to fit 449 USDC deployer budget
# At 571 points, full 90k shares would need 514 USDC
# Use smaller auction to stay under budget
REQUIRED_RAISE_USDC_RAW=45000000

# Per-applicant cap (higher for larger point values)
APPLICANT_CAP_USDC_RAW=60000000

# Demo bids: scaled to stay under 449 USDC budget
# Total 90 USDC for 15k shares at 571 points
BID_AMOUNTS=20000000,20000000,20000000,15000000,15000000
BID_MAX_POINTS=1085
