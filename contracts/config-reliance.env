# Reliance Industries Limited Demo Configuration
# Source: NSE Nov 6 2026 close ₹1320.00 (charting.in)
# Scaled proportionally: (1320/231.20) * 100 = 571 points

# Identity
DEMO_LABEL=reliance-v1
DEPLOYMENTS_FILE=deployments/reliance.json
STOCK_NAME="Reliance Industries Limited"
STOCK_SYMBOL=RELIANCE
STOCK_TICKER=reliance
ENS_TICKER=reliance

# Price configuration (INR ₹1320 → 571 points issue)
ISSUE_POINTS=571
FLOOR_POINTS=457        # 80% of issue
CAP_PERCENT=190         # Cap at 190% = 1085 points

# Supply
TOTAL_SUPPLY_SHARES=110000
AUCTION_SUPPLY_SHARES=90000
LP_RESERVE_SHARES=20000

# Auction timing: 5 minutes total
BID_WINDOW_BLOCKS=20
CLEAR_BLOCKS=5

# Minimum raise: at 571 points, 90k shares = 514 USDC target; require 50%
# 90000 shares * 571 points * 0.01 USDC/point / 1000 shares per lot = 514 USDC
REQUIRED_RAISE_USDC_RAW=257000000

# Per-applicant cap (higher for larger point values)
APPLICANT_CAP_USDC_RAW=60000000

# Demo bids: scaled up for 571 point price
# Total ~565 USDC to demonstrate clearing
BID_AMOUNTS=60000000,60000000,60000000,60000000,60000000,60000000,60000000,60000000,60000000,45000000
BID_MAX_POINTS=1085
