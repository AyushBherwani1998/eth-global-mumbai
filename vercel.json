{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "",
  "framework": null,
  "rewrites": [
    { "source": "/api/policy(.*)", "destination": "/api/policy" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "{contracts/deployments/sepolia*.json,contracts/abis/**,services/api/src/**}",
      "maxDuration": 60
    },
    "api/policy.ts": {
      "includeFiles": "services/mock-exchange/src/**",
      "maxDuration": 10
    }
  }
}
